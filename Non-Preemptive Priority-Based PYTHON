
n = int(input("Enter the number of processes: "))

bt = []
priority = []
p = []
wt = []
tat = []

# Input Burst Time and Priority
for i in range(n):
    b = int(input("Enter Burst Time for P{}: ".format(i + 1)))
    pr = int(input("Enter Priority for P{}: ".format(i + 1)))

    bt.append(b)
    priority.append(pr)
    p.append(i + 1)

# Sort processes according to Priority
for i in range(n):
    for j in range(0, n - i - 1):
        if priority[j] > priority[j + 1]:

            # Swap Priority
            priority[j], priority[j + 1] = priority[j + 1], priority[j]

            # Swap Burst Time
            bt[j], bt[j + 1] = bt[j + 1], bt[j]

            # Swap Process Number
            p[j], p[j + 1] = p[j + 1], p[j]

# Calculate Waiting Time
wt.append(0)

for i in range(1, n):
    wt.append(wt[i - 1] + bt[i - 1])

# Calculate Turnaround Time
for i in range(n):
    tat.append(wt[i] + bt[i])

# Calculate Average Waiting and Turnaround Time
avg_wt = sum(wt) / n
avg_tat = sum(tat) / n

# Display Results
print("\nProcess\tBurst Time\tPriority\tWaiting Time\tTurnaround Time")

for i in range(n):
    print("P{}\t{}\t\t{}\t\t{}\t\t{}".format(
        p[i], bt[i], priority[i], wt[i], tat[i]
    ))

print("\nAverage Waiting Time:", avg_wt)
print("Average Turnaround Time:", avg_tat)
