
#include <iostream>
using namespace std;

int main()
{
    int n;
    int bt[20], wt[20], tat[20];
    float avg_wt = 0, avg_tat = 0;

    cout << "Enter the number of processes: ";
    cin >> n;

    // Input burst time
    for(int i = 0; i < n; i++)
    {
        cout << "Enter Burst Time for P" << i + 1 << ": ";
        cin >> bt[i];
    }

    // Calculate waiting time
    wt[0] = 0;

    for(int i = 1; i < n; i++)
    {
        wt[i] = wt[i - 1] + bt[i - 1];
    }

    // Calculate turnaround time
    for(int i = 0; i < n; i++)
    {
        tat[i] = wt[i] + bt[i];
    }

    // Calculate averages
    for(int i = 0; i < n; i++)
    {
        avg_wt += wt[i];
        avg_tat += tat[i];
    }

    avg_wt /= n;
    avg_tat /= n;

    // Display results
    cout << "\nProcess\tBurst Time\tWaiting Time\tTurnaround Time\n";

    for(int i = 0; i < n; i++)
    {
        cout << "P" << i + 1 << "\t"
             << bt[i] << "\t\t"
             << wt[i] << "\t\t"
             << tat[i] << endl;
    }

    cout << "\nAverage Waiting Time = " << avg_wt;
    cout << "\nAverage Turnaround Time = " << avg_tat;

    return 0;
}
