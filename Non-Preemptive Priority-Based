#include <iostream>
using namespace std;

int main()
{
    int n;
    int bt[20], priority[20], p[20];
    int wt[20], tat[20];
    float avg_wt = 0, avg_tat = 0;

    cout << "Enter the number of processes: ";
    cin >> n;

    // Input Burst Time and Priority
    for(int i = 0; i < n; i++)
    {
        p[i] = i + 1;

        cout << "Enter Burst Time for P" << i + 1 << ": ";
        cin >> bt[i];

        cout << "Enter Priority for P" << i + 1 << ": ";
        cin >> priority[i];
    }

    // Sort processes according to Priority
    for(int i = 0; i < n - 1; i++)
    {
        for(int j = 0; j < n - i - 1; j++)
        {
            if(priority[j] > priority[j + 1])
            {
                // Swap Priority
                int temp = priority[j];
                priority[j] = priority[j + 1];
                priority[j + 1] = temp;

                // Swap Burst Time
                temp = bt[j];
                bt[j] = bt[j + 1];
                bt[j + 1] = temp;

                // Swap Process Number
                temp = p[j];
                p[j] = p[j + 1];
                p[j + 1] = temp;
            }
        }
    }

    // Calculate Waiting Time
    wt[0] = 0;

    for(int i = 1; i < n; i++)
    {
        wt[i] = wt[i - 1] + bt[i - 1];
    }

    // Calculate Turnaround Time
    for(int i = 0; i < n; i++)
    {
        tat[i] = wt[i] + bt[i];
    }

    // Calculate Average Waiting and Turnaround Time
    for(int i = 0; i < n; i++)
    {
        avg_wt += wt[i];
        avg_tat += tat[i];
    }

    avg_wt /= n;
    avg_tat /= n;

    // Display Results
    cout << "\nProcess\tBurst Time\tPriority\tWaiting Time\tTurnaround Time\n";

    for(int i = 0; i < n; i++)
    {
        cout << "P" << p[i] << "\t"
             << bt[i] << "\t\t"
             << priority[i] << "\t\t"
             << wt[i] << "\t\t"
             << tat[i] << endl;
    }

    cout << "\nAverage Waiting Time = " << avg_wt;
    cout << "\nAverage Turnaround Time = " << avg_tat;

    return 0;
}
